{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "query-mind-frontend",
  "compatibility_date": "2026-08-25",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://query-mind-backend.onrender.com"
  },
  "observability": {
    "enabled": true
  }
}
